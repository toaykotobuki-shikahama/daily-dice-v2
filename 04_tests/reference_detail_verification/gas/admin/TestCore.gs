/* V2 trial ledger: distinct DB; never web-deploy the admin project. */
const TEST_VERSION_='dice-2.0-49b0bb79';
const TRIAL_SCHEMAS_={
 'テストマスタ':['テストVer','テストID','順序','テスト名','操作種類','開始条件','操作手順','正常条件','計測開始点','計測終了点','目標試行回数','判定条件','中断時の扱い','テスト定義Ver','有効'],
 'テスト実施履歴':['実施ID','実施者','操作アカウント','実施開始日時','最終実施日時','アプリVer','テストVer','目標回数','実施回数','成功回数','失敗回数','中断回数','未確認回数','実施状況','所感','計画JSON','状態JSON','操作履歴JSON'],
 'テスト操作ログ':['試行ID','実施ID','テストID','試行番号','アプリVer','テストVer','テスト定義Ver','実施者','操作アカウント','操作名','試行開始イベント','開始根拠','開始日時','終了日時','操作処理時間ms','GAS往復時間ms','GAS通信回数','GAS計測区間ms','演出時間ms','結果','通信結果','エラー内容','端末情報','通信環境','動作結果','操作感','問題の種類','所感','証拠URL','対応状況','要求ID','条件JSON','状態JSON','通信JSON','計測JSON','認可値'],
 'テスト検証サマリー':['アプリVer','テストVer','テストID','テスト定義Ver','条件識別値','端末区分','通信環境','目標回数','実施回数','成功回数','失敗回数','中断回数','未確認回数','達成率','正常完了率','失敗率','操作計測件数','操作未取得件数','操作平均ms','操作中央値ms','操作最大ms','操作P95ms','GAS往復平均ms','GAS計測区間平均ms','演出平均ms','快適','普通','遅い','使いにくい','不具合報告数','未確認','確認中','修正済','再テスト待ち','完了','更新日時']
};
const TRIAL_LIMITS_={logs:10000,sessions:100,trials:2000,requests:10000,perMinute:20,globalMinute:30,minIntervalMs:2000,timeoutMs:30000};
function trialAuth_(){return authorize_();}
function trialDb_(){const p=props_(),id=p.getProperty('TEST_TRIAL_SPREADSHEET_ID');if(!id)throw Error('「テストマスタ初期作成」を実行してください');if([p.getProperty('SPREADSHEET_ID'),p.getProperty('TEST_SPREADSHEET_ID')].includes(id))throw Error('安全停止：本番または旧検証DBが指定されています');const ss=SpreadsheetApp.openById(id);if(!ss.getName().startsWith('サイコロ検証専用DB_試行版'))throw Error('検証DBの名称が一致しません');return ss;}
function trialRows_(name){if(!TRIAL_SCHEMAS_[name])throw Error('検証用以外のシートを操作できません');const sh=trialDb_().getSheetByName(name);if(!sh)throw Error('検証用シートがありません');const h=TRIAL_SCHEMAS_[name],v=sh.getDataRange().getValues();if(h.some((x,i)=>v[0][i]!==x))throw Error('試行版の見出しを確認してください');return v.slice(1).map((r,i)=>Object.assign({_row:i+2},Object.fromEntries(h.map((k,j)=>[k,r[j] instanceof Date?r[j].toISOString():r[j]])))).filter(r=>r[h[0]]!=='');}
function trialWrite_(name,obj){const h=TRIAL_SCHEMAS_[name];if(!h)throw Error('書込先を確認してください');const sh=trialDb_().getSheetByName(name),values=h.map(k=>cell_(obj[k]===undefined?'':obj[k]));if(obj._row)sh.getRange(obj._row,1,1,h.length).setValues([values]);else{if(sh.getLastRow()>TRIAL_LIMITS_.logs)throw Error('ログ上限です。CSVを保管し管理者へ連絡してください');sh.appendRow(values);}SpreadsheetApp.flush();}
function trialText_(v,n){if(typeof v!=='string'||v.length>n)throw Error('入力文字数を確認してください');return v;}
function trialRate_(email){const p=props_(),now=Date.now(),minute=Math.floor(now/60000),k='trial-rate:'+hash_(email),u=JSON.parse(p.getProperty(k)||'{}'),g=JSON.parse(p.getProperty('trial-rate:all')||'{}');if(now-(u.at||0)<2000)throw Error('通信間隔を空けてください（前回のGAS受付から2秒未満）');if(u.minute===minute&&u.count>=20)throw Error('通信間隔を空けてください（このアカウントの1分間の上限）');if(g.minute===minute&&g.count>=30)throw Error('通信間隔を空けてください（検証全体の1分間の上限）');p.setProperty(k,JSON.stringify({at:now,minute,count:u.minute===minute?u.count+1:1}));p.setProperty('trial-rate:all',JSON.stringify({minute,count:g.minute===minute?g.count+1:1}));}
function trialSession_(id,email){const row=trialRows_('テスト実施履歴').find(r=>r['実施ID']===id);if(!row||row['操作アカウント']!==email)throw Error('実施IDまたは権限を確認してください');const logs=trialRows_('テスト操作ログ').filter(r=>r['実施ID']===id);let state=JSON.parse(row['状態JSON']);for(const log of logs){const s=JSON.parse(log['状態JSON']||'{}');if(s.rev>state.rev)state=s;}return {row,plan:JSON.parse(row['計画JSON']),state,logs};}
function trialCount_(t,itemId){const logs=t.logs.filter(r=>r['試行開始イベント']===true||r['試行開始イベント']==='true').filter(r=>!itemId||r['テストID']===itemId);return {total:logs.length,success:logs.filter(r=>r['結果']==='成功').length,failure:logs.filter(r=>r['結果']==='失敗').length,interrupted:logs.filter(r=>r['結果']==='中断').length,unknown:logs.filter(r=>r['結果']==='未確認').length};}
function trialView_(t){return {id:t.row['実施ID'],name:t.row['実施者'],email:t.row['操作アカウント'],ver:t.row['テストVer'],appVersion:t.row['アプリVer'],plan:t.plan.map(x=>({...x,counts:trialCount_(t,x.id)})),state:t.state,counts:trialCount_(t),limits:TRIAL_LIMITS_,recent:t.logs.slice(-8).map(r=>({id:r['試行ID'],itemId:r['テストID'],started:r['試行開始イベント'],result:r['結果'],error:r['エラー内容'],opMs:r['操作処理時間ms']}))};}
function trialGame_(t){const s=t.state;return {ok:true,campaign:{id:t.row['実施ID'],name:'検証専用',target:7,active:true,receptionOpen:true},serverTime:iso_(),card:{reference:'TEST',state:s.cardState,total:Math.min(7,s.total),actualTotal:s.total,canRoll:props_().getProperty('TEST_TRIAL_ENABLED')!=='false'&&s.phase==='実施中'&&s.cardState==='ACTIVE'&&!!s.active,confirmationCode:s.code,confirmationExpiresAt:iso_(new Date(Date.now()+900000)),lastResult:s.last}};}
function trialReply_(t,extra){return {ok:true,session:trialView_(t),game:trialGame_(t),...extra};}
function trialFinite_(v){return Number.isFinite(v)&&v>=0&&v<=3600000?v:'';}
function trialArray_(row,key){return JSON.parse(row[key]||'[]');}
function trialControl_(t,action){const s=t.state;s.rev++;const history=JSON.parse(t.row['操作履歴JSON']||'[]');history.push({action,at:iso_()});t.row['操作履歴JSON']=JSON.stringify(history.slice(-300));t.row['状態JSON']=JSON.stringify(s);t.row['最終実施日時']=iso_();t.row['実施状況']=s.phase;const c=trialCount_(t);Object.assign(t.row,{'実施回数':c.total,'成功回数':c.success,'失敗回数':c.failure,'中断回数':c.interrupted,'未確認回数':c.unknown});trialWrite_('テスト実施履歴',t.row);}
