function buildDiceTestMenu_(){return SpreadsheetApp.getUi().createMenu('スタッフ検証').addItem('スタッフ検証画面','showDiceTestRunner').addItem('テストマスタ初期作成','setupDiceTesting').addItem('テストマスタ更新','updateTrialMaster').addItem('テスト結果集計','refreshDiceTestResults').addItem('テスト検証サマリー更新','refreshDiceTestSummary').addItem('詳細・サマリーCSV出力','exportDiceTestCsv').addItem('検証モードを停止／再開','toggleTrialTesting').addItem('テストデータ初期化','resetDiceTestData');}
function setupDiceTesting(){trialAuth_();withLock_(()=>{const p=props_();if(!p.getProperty('TEST_TRIAL_SPREADSHEET_ID')){const ss=SpreadsheetApp.create('サイコロ検証専用DB_試行版');ss.setSpreadsheetTimeZone('Asia/Tokyo');p.setProperty('TEST_TRIAL_SPREADSHEET_ID',ss.getId());}if(!p.getProperty('TEST_RANDOM_KEY'))p.setProperty('TEST_RANDOM_KEY',Utilities.getUuid()+Utilities.getUuid());const ss=trialDb_();Object.entries(TRIAL_SCHEMAS_).forEach(([name,h])=>{let sh=ss.getSheetByName(name);if(!sh)sh=ss.insertSheet(name);if(sh.getMaxColumns()<h.length)sh.insertColumnsAfter(sh.getMaxColumns(),h.length-sh.getMaxColumns());if(!sh.getLastRow()){sh.getRange(1,1,1,h.length).setValues([h]);sh.setFrozenRows(1);sh.getRange(1,1,1,h.length).setBackground('#142a46').setFontColor('#ffffff').setFontWeight('bold').setWrap(true);sh.setColumnWidths(1,h.length,150);sh.setRowHeight(1,48);}});if(!trialRows_('テストマスタ').length)trialSeed_().forEach(r=>{r['テスト定義Ver']=trialDefinition_(r);trialWrite_('テストマスタ',r);});ss.getSheetByName('テストマスタ').setColumnWidth(7,440);ss.getSheetByName('テストマスタ').setColumnWidth(8,300);ss.getSheetByName('テスト操作ログ').getRange('AD2:AD'+ss.getSheetByName('テスト操作ログ').getMaxRows()).setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(['未確認','確認中','修正済','再テスト待ち','完了'],true).setAllowInvalid(false).build());ss.getSheetByName('テストマスタ').getRange('O2:O1000').setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(['有効','無効'],true).setAllowInvalid(false).build());});SpreadsheetApp.getUi().alert('試行版の検証DBを作成しました。旧検証・本番は保持しています。\n'+trialDb_().getUrl());}
function updateTrialMaster(){trialAuth_();withLock_(()=>trialRows_('テストマスタ').forEach(r=>{r['テスト定義Ver']=trialDefinition_(r);trialWrite_('テストマスタ',r);}));SpreadsheetApp.getUi().alert('条件を識別する定義Verを更新しました。開始済み実施の条件は維持します。');}
function showDiceTestRunner(){trialAuth_();trialDb_();SpreadsheetApp.getUi().showModelessDialog(HtmlService.createHtmlOutputFromFile('TestRunner').setWidth(1100).setHeight(820),'スタッフ検証：試行回数版');}
function trialRefresh_(){const sessions=trialRows_('テスト実施履歴');for(const row of sessions){const t=trialSession_(row['実施ID'],row['操作アカウント']);trialGoal_(t);trialControl_(t,'集計');}return sessions.length;}
function trialStats_(values){const v=values.filter(x=>x!==''&&x!==null&&Number.isFinite(Number(x))).map(Number).sort((a,b)=>a-b);if(!v.length)return {n:0,mean:'未取得',median:'未取得',max:'未取得',p95:'未取得'};return {n:v.length,mean:Math.round(v.reduce((a,b)=>a+b,0)/v.length),median:v.length%2?v[(v.length-1)/2]:(v[v.length/2-1]+v[v.length/2])/2,max:v[v.length-1],p95:v[Math.ceil(v.length*.95)-1]};}
function trialSummary_(){trialRefresh_();const groups={};for(const r of trialRows_('テスト操作ログ')){if(r['試行開始イベント']!==true&&r['試行開始イベント']!=='true')continue;const parts=[r['アプリVer'],r['テストVer'],r['テストID'],r['テスト定義Ver'],hash_(r['条件JSON']).slice(0,12),r['端末情報'],r['通信環境']],key=JSON.stringify(parts);if(!groups[key])groups[key]={parts,rows:[]};groups[key].rows.push(r);}const data=Object.values(groups).map(g=>{const rows=g.rows,n=rows.length,op=trialStats_(rows.map(r=>r['操作処理時間ms'])),rtt=trialStats_(rows.map(r=>r['GAS往復時間ms'])),gas=trialStats_(rows.map(r=>r['GAS計測区間ms'])),anim=trialStats_(rows.map(r=>r['演出時間ms'])),count=v=>rows.filter(r=>r['結果']===v).length,target=Number(JSON.parse(rows[0]['条件JSON']).target)*new Set(rows.map(r=>r['実施ID'])).size;const out=Object.fromEntries(TRIAL_SCHEMAS_['テスト検証サマリー'].slice(0,7).map((k,i)=>[k,g.parts[i]]));Object.assign(out,{'目標回数':target,'実施回数':n,'成功回数':count('成功'),'失敗回数':count('失敗'),'中断回数':count('中断'),'未確認回数':count('未確認'),'達成率':Math.min(1,n/target),'正常完了率':count('成功')/n,'失敗率':count('失敗')/n,'操作計測件数':op.n,'操作未取得件数':n-op.n,'操作平均ms':op.mean,'操作中央値ms':op.median,'操作最大ms':op.max,'操作P95ms':op.p95,'GAS往復平均ms':rtt.mean,'GAS計測区間平均ms':gas.mean,'演出平均ms':anim.mean,'不具合報告数':rows.filter(r=>r['動作結果']==='異常'||r['結果']==='失敗').length,'更新日時':iso_()});for(const k of ['快適','普通','遅い','使いにくい'])out[k]=rows.filter(r=>r['操作感']===k).length;for(const k of ['未確認','確認中','修正済','再テスト待ち','完了'])out[k]=rows.filter(r=>r['対応状況']===k).length;return out;});const sh=trialDb_().getSheetByName('テスト検証サマリー'),h=TRIAL_SCHEMAS_['テスト検証サマリー'];if(sh.getLastRow()>1)sh.getRange(2,1,sh.getLastRow()-1,h.length).clearContent();if(data.length)sh.getRange(2,1,data.length,h.length).setValues(data.map(r=>h.map(k=>r[k]??'')));sh.getRange('N2:P1000').setNumberFormat('0.0%');return data;}
function refreshDiceTestResults(){trialAuth_();const n=withLock_(trialRefresh_);SpreadsheetApp.getUi().alert(n+'実施を集計しました');}
function refreshDiceTestSummary(){trialAuth_();const n=withLock_(trialSummary_).length;SpreadsheetApp.getUi().alert(n+'組の条件・端末別サマリーを更新しました');}
function trialCsv_(v){return '\uFEFF'+v.map(row=>row.map(x=>'"'+String(x??'').replace(/^[=+\-@]/,"'$&").replace(/"/g,'""')+'"').join(',')).join('\r\n');}
function exportDiceTestCsv(){trialAuth_();const files=withLock_(()=>{trialSummary_();const logs=trialDb_().getSheetByName('テスト操作ログ').getDataRange().getValues(),h=TRIAL_SCHEMAS_['テスト操作ログ'],keep=h.map((k,i)=>[k,i]).filter(([k])=>k!=='認可値');return [{name:'詳細_試行ログ_'+day_()+'.csv',text:trialCsv_(logs.map(r=>keep.map(([,j])=>r[j])))},{name:'サマリー_'+day_()+'.csv',text:trialCsv_(trialDb_().getSheetByName('テスト検証サマリー').getDataRange().getValues())},{name:'実施履歴_'+day_()+'.csv',text:trialCsv_(trialDb_().getSheetByName('テスト実施履歴').getDataRange().getValues())},{name:'テスト定義_'+day_()+'.csv',text:trialCsv_(trialDb_().getSheetByName('テストマスタ').getDataRange().getValues())}];});const html=HtmlService.createTemplateFromFile('TestExport');html.payload=JSON.stringify(files).replace(/</g,'\\u003c');SpreadsheetApp.getUi().showModalDialog(html.evaluate().setWidth(520).setHeight(380),'試行詳細・サマリーCSV');}
function toggleTrialTesting(){trialAuth_();const p=props_(),enabled=p.getProperty('TEST_TRIAL_ENABLED')==='false';p.setProperty('TEST_TRIAL_ENABLED',enabled?'true':'false');SpreadsheetApp.getUi().alert(enabled?'検証モードを再開しました':'検証モードだけ停止しました。本番には影響しません。');}
function resetDiceTestData(){trialAuth_();const ui=SpreadsheetApp.getUi(),p=ui.prompt('試行版データ初期化','全員が中断しCSVを保存後、「試行テストだけ初期化」と入力。旧DB・本番・マスタは残します。',ui.ButtonSet.OK_CANCEL);if(p.getSelectedButton()!==ui.Button.OK||p.getResponseText()!=='試行テストだけ初期化')return;withLock_(()=>{const ss=trialDb_(),names=['テスト実施履歴','テスト操作ログ','テスト検証サマリー'],stamp=Utilities.getUuid().slice(0,8);names.forEach(n=>ss.getSheetByName(n).copyTo(ss).setName('初期化前_'+stamp+'_'+n).hideSheet());names.forEach(n=>{const sh=ss.getSheetByName(n);if(sh.getLastRow()>1)sh.getRange(2,1,sh.getLastRow()-1,TRIAL_SCHEMAS_[n].length).clearContent();});});ui.alert('試行版の記録だけ初期化しました');}
