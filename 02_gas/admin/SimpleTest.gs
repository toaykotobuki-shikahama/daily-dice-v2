const SIMPLE_TEST_HEADERS={Sessions:['sessionId','generation','staffEmail','total','state','createdAt','updatedAt'],Events:['eventId','sessionId','generation','face','earned','totalAfter','createdAt']};
function simpleTestDb_(){const id=PropertiesService.getScriptProperties().getProperty('TEST_DB_ID');if(!id)throw new Error('TEST_DB_NOT_CONFIGURED');if(id===PropertiesService.getScriptProperties().getProperty('DB_ID'))throw new Error('TEST_DB_MUST_BE_SEPARATE');const ss=SpreadsheetApp.openById(id);for(const [name,h] of Object.entries(SIMPLE_TEST_HEADERS)){let sh=ss.getSheetByName(name);if(!sh)sh=ss.insertSheet(name);if(!sh.getLastRow())sh.appendRow(h);if(JSON.stringify(sh.getRange(1,1,1,h.length).getDisplayValues()[0])!==JSON.stringify(h))throw new Error('TEST_SCHEMA_MISMATCH');}return ss;}
function simpleTestCurrent_(){const s=simpleTestDb_().getSheetByName('Sessions');if(s.getLastRow()<2)return null;const r=s.getRange(s.getLastRow(),1,1,7).getValues()[0];return {sessionId:r[0],generation:Number(r[1]),staffEmail:r[2],total:Number(r[3]),state:r[4]};}
function simpleTestStart(){const email=adminAllowed_();return v2AdminLock_(()=>{const ss=simpleTestDb_(),old=simpleTestCurrent_(),gen=(old?old.generation:0)+1,id=Utilities.getUuid();ss.getSheetByName('Sessions').appendRow([id,gen,email,0,'ACTIVE',new Date(),new Date()]);return {ok:true,sessionId:id,generation:gen,total:0,target:7};});}
function simpleTestRoll(sessionId,generation){adminAllowed_();return v2AdminLock_(()=>{const ss=simpleTestDb_(),s=simpleTestCurrent_();if(!s||s.sessionId!==sessionId||s.generation!==Number(generation))throw new Error('STALE_SESSION');if(s.state!=='ACTIVE')throw new Error('TEST_NOT_ACTIVE');const face=Math.floor(Math.random()*6)+1,earned=[1,1,1,2,2,3][face-1],total=s.total+earned,state=total>=7?'ACHIEVED':'ACTIVE';const id=Utilities.getUuid();ss.getSheetByName('Events').appendRow([id,sessionId,generation,face,earned,total,new Date()]);const sh=ss.getSheetByName('Sessions'),row=sh.getLastRow();sh.getRange(row,4,1,2).setValues([[total,state]]);sh.getRange(row,7).setValue(new Date());return {ok:true,eventId:id,face,earned,total,state};});}
function simpleTestComplete(sessionId,generation,staffName){const email=adminAllowed_();if(!String(staffName||'').trim())throw new Error('INVALID_STAFF_NAME');return v2AdminLock_(()=>{const s=simpleTestCurrent_();if(!s||s.sessionId!==sessionId||s.generation!==Number(generation))throw new Error('STALE_SESSION');if(s.state!=='ACHIEVED')throw new Error('NOT_ACHIEVED');const sh=simpleTestDb_().getSheetByName('Sessions');sh.getRange(sh.getLastRow(),5).setValue('COMPLETED');sh.getRange(sh.getLastRow(),7).setValue(new Date());return {ok:true,completed:true,staff:email};});}
function simpleTestReset(sessionId,generation){adminAllowed_();return v2AdminLock_(()=>{const s=simpleTestCurrent_();if(!s||s.sessionId!==sessionId||s.generation!==Number(generation))throw new Error('STALE_SESSION');const ss=simpleTestDb_(),gen=s.generation+1,id=Utilities.getUuid();ss.getSheetByName('Sessions').appendRow([id,gen,Session.getActiveUser().getEmail(),0,'ACTIVE',new Date(),new Date()]);return {ok:true,sessionId:id,generation:gen,total:0,target:7};});}
